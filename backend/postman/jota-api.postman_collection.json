    {
      "name": "Auth",
      "description": "Registro, login y perfil. Correr en orden: el registro crea un usuario con un email nuevo cada vez y guarda el token en la variable token.",
      "item": [
        {
          "name": "Registro",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('usuarioEmail', `prueba-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "",
                  "const { token, usuario } = pm.response.json();",
                  "",
                  "pm.test('devuelve token', () => pm.expect(token).to.be.a('string'));",
                  "pm.test('el usuario no trae la contraseña', () => pm.expect(usuario).to.not.have.property('password'));",
                  "",
                  "pm.collectionVariables.set('token', token);",
                  "pm.collectionVariables.set('usuarioId', usuario._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente de Prueba\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"{{usuarioPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
