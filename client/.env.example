# Configuración del frontend.
#
# Copiá este archivo como .env y ajustá el puerto si el backend corre en otro.
# (.env está en .gitignore, así que cada uno tiene el suyo local.)
VITE_API_URL=http://localhost:3000

# El backend corre en el 3000 y el frontend lo levanta Vite en el 5173, así que
# no se pisan. El front llama directo a la API porque el backend tiene CORS
# configurado; las imágenes del catálogo también salen de ahí, ya que las sirve
# como archivos estáticos desde public/catalogo/.
#
# Si en tu máquina el 3000 está ocupado, levantá el backend con PORT=4000
# (desde la carpeta backend) y poné VITE_API_URL=http://localhost:4000 acá.
#
# Alternativa sin CORS: dejar VITE_API_URL vacío y activar el proxy del dev
# server en vite.config.js, para que /api se reenvíe al backend desde el mismo
# origen. Con esa opción las imágenes NO funcionan, porque el proxy solo cubre
# /api. Si elegís esta vía, las imágenes tienen que servirse desde el front
# (client/public/catalogo/).
# VITE_API_URL=